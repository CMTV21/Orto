{
  "name": "orto",
  "compatibility_date": "2025-06-05",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "orto-accounts", "database_id": "77a4abb7-954c-4413-9fe4-57350724dc20" }
  ],
  "services": [
    { "binding": "EMAILER", "service": "cmtv-emailer" }
  ]
}
